@page
@model FI.Api.Pages.Demo.GoldenIncidentModel
@{
    ViewData["Title"] = "Golden Incident Demo";
    Layout = "_DemoLayout";
}

<div class="fi-demo-banner">
    <strong>Static demo snapshot</strong> — these are frozen, read-only copies of real FI runs
    (no login required, no live data, no actions possible here).
    <a href="mailto:muratberatkeskin@gmail.com?subject=FI%20Demo%20Access">Ask for live access →</a>
</div>

<div class="fi-demo-tabs" role="tablist">
    @foreach (var s in Model.Scenarios)
    {
        <button type="button" class="fi-demo-tab" data-target="scenario-@s.Id" role="tab">@s.TabLabel</button>
    }
</div>

@foreach (var s in Model.Scenarios)
{
    <div class="fi-demo-panel" id="scenario-@s.Id" data-panel>
        <div class="fi-detail-header">
            <div>
                <h1 class="fi-page-title">@s.IntegrationName — @s.Category</h1>
                <div class="fi-detail-meta">
                    First seen @s.FirstSeen · Last seen @s.LastSeen · @s.EventCount events
                </div>
            </div>
            <div>
                <span class="fi-badge @SeverityBadgeClass(s.Severity)">@s.Severity</span>
                <span class="fi-badge @s.StatusBadgeClass">@s.StatusLabel</span>
            </div>
        </div>

        <div class="fi-section">
            <h2>Business Impact</h2>
            <p class="fi-impact-legend">
                Event = a raw technical failure · Operation = a real business action those events
                represent · Customer = a real person or account affected by it.
            </p>
            <div class="fi-ai-row fi-card">
                <div><strong>Technical events</strong>@s.EventCount</div>
                <div><strong>Known operations</strong>@(s.KnownOperations ?? "n/a for this connector")</div>
                <div><strong>Affected customers</strong>@(s.AffectedCustomers ?? "n/a for this connector")</div>
                <div><strong>Duration</strong>@s.Duration</div>
            </div>
        </div>

        <div class="fi-section">
            <h2>What should I do now?</h2>
            <div class="fi-suggested-action"><strong>Suggested first step:</strong> @s.SuggestedAction</div>
        </div>

        <div class="fi-section">
            <h2>AI-Assisted Analysis</h2>
            @if (s.Ai is not null)
            {
                <div class="fi-card fi-ai-card">
                    <p class="fi-ai-title">@s.Ai.Title</p>
                    <strong class="fi-eyebrow">Probable cause (AI-assisted interpretation, not confirmed evidence)</strong>
                    <p>@s.Ai.ProbableRootCause</p>
                    <div class="fi-ai-row">
                        <div>
                            <strong>Confidence</strong>
                            <div class="fi-confidence-bar"><div class="fi-confidence-fill" style="width:@((int)(s.Ai.Confidence * 100))%"></div></div>
                            @((int)(s.Ai.Confidence * 100))%
                        </div>
                        <div>
                            <strong>Needs human review?</strong>
                            <span class="fi-badge @(s.Ai.NeedsHumanReview ? "fi-badge-review" : "fi-badge-analyzed")">
                                @(s.Ai.NeedsHumanReview ? "Yes" : "No")
                            </span>
                        </div>
                    </div>
                    <div>
                        <strong class="fi-eyebrow">AI-suggested actions</strong>
                        <ul class="fi-actions-list">
                            @foreach (var a in s.Ai.RecommendedActions)
                            {
                                <li>@a</li>
                            }
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="fi-empty">@s.NoAiReason</div>
            }
        </div>

        <div class="fi-section">
            <h2>Evidence (@s.Evidence.Count)</h2>
            <div class="fi-evidence-list">
                @foreach (var e in s.Evidence)
                {
                    <div class="fi-evidence-card">
                        <div class="fi-evidence-source">@e.SourceType</div>
                        <div class="fi-evidence-summary">@e.Summary</div>
                        <div class="fi-evidence-time">@e.CollectedAt</div>
                    </div>
                }
            </div>
        </div>

        <div class="fi-section">
            <h2>Timeline</h2>
            <div class="fi-timeline">
                @foreach (var t in s.Timeline)
                {
                    <div class="fi-timeline-item">
                        <div>@t.Label</div>
                        <div class="fi-timeline-time">@t.At</div>
                    </div>
                }
            </div>
        </div>

        <div class="fi-section">
            <details class="fi-dev-detail">
                <summary>Developer / technical detail</summary>
                <div class="fi-card fi-fingerprint">@s.Fingerprint</div>
            </details>
        </div>
    </div>
}

<div class="fi-demo-footer">
    Want to see this resolve and auto-reopen live, or run it against your own integration?
    <a href="mailto:muratberatkeskin@gmail.com?subject=FI%20Demo%20Access">Get in touch →</a>
</div>

<script>
  (function () {
    var tabs = document.querySelectorAll('.fi-demo-tab');
    var panels = document.querySelectorAll('[data-panel]');
    function activate(id) {
      panels.forEach(function (p) { p.style.display = (p.id === id) ? '' : 'none'; });
      tabs.forEach(function (t) { t.classList.toggle('fi-demo-tab-active', t.dataset.target === id); });
    }
    tabs.forEach(function (t) {
      t.addEventListener('click', function () { activate(t.dataset.target); });
    });
    if (tabs.length > 0) activate(tabs[0].dataset.target);
  })();
</script>

@functions {
    string SeverityBadgeClass(string severity) => severity switch
    {
        "Critical" => "fi-badge-critical",
        "High" => "fi-badge-high",
        "Medium" => "fi-badge-medium",
        "Low" => "fi-badge-low",
        _ => "fi-badge-neutral"
    };
}
